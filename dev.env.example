# Development settings. Copy to dev.env, which git ignores, and source it before running the app.
export GRADEFLOW_DEBUG=true
export GRADEFLOW_SECRET_KEY=development-only
export GRADEFLOW_DATABASE_URL=postgres://gradeflow:gradeflow@localhost:5434/gradeflow
export GRADEFLOW_EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
export GRADEFLOW_EMAIL_FILE_PATH=/tmp/gradeflow-emails

# GRADEFLOW_CACHE_DIR optionally overrides core's default ~/.cache/gradeflow artifact cache.

# The Nomad agent, and where its jobs' containers reach this machine (on Docker Desktop, host.docker.internal).
export GRADEFLOW_NOMAD_URL=http://localhost:4646
export GRADEFLOW_APP_URL_FOR_JOBS=http://172.17.0.1:8000
export GRADEFLOW_ALLOWED_HOSTS=localhost,127.0.0.1,172.17.0.1,host.docker.internal

# The AI services people may connect, each name with its OpenAI-compatible endpoint.
export GRADEFLOW_MODEL_PROVIDERS='{"Example AI": "https://models.example.com/v1"}'
